{
  "name": "markwise-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:mobile": "npm --prefix apps/mobile run start",
    "build": "npm --prefix apps/web run build",
    "build:web": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "start:web": "npm --prefix apps/web run start",
    "lint": "npm --prefix apps/web run lint",
    "test": "npm --prefix apps/web run test",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:rebuild": "docker-compose up -d --build",
    "prisma:generate": "npm --prefix apps/web run prisma:generate",
    "prisma:push": "npm --prefix apps/web run prisma:push",
    "prisma:migrate": "npm --prefix apps/web run prisma:migrate"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.11.0"
  }
}
