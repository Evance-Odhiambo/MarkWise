{
  "name": "@markwise/mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/fix-android-manifests.js",
    "android": "npx react-native run-android",
    "ios": "npx react-native run-ios",
    "lint": "eslint .",
    "start": "npx react-native start",
    "test": "jest",
    "build:android:apk": "node scripts/guard-windows-release.js && node scripts/gradle.js assembleRelease",
    "build:android:aab": "node scripts/guard-windows-release.js && node scripts/gradle.js bundleRelease",
    "build:android:debug": "node scripts/gradle.js assembleDebug",
    "build:ios:release": "npx react-native run-ios --mode Release",
    "build:ios:archive": "xcodebuild -workspace ios/MarkWise.xcworkspace -scheme MarkWise -configuration Release -archivePath ios/build/MarkWise.xcarchive archive",
    "build:ios:ipa": "xcodebuild -exportArchive -archivePath ios/build/MarkWise.xcarchive -exportOptionsPlist ios/ExportOptions.plist -exportPath ios/build/",
    "clean:android": "node scripts/gradle.js clean",
    "clean:ios": "cd ios && xcodebuild clean"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/checkbox": "^0.5.20",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-documents/picker": "^12.0.1",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/messaging": "^23.8.8",
    "@react-native-picker/picker": "^2.11.4",
    "@react-native/new-app-screen": "0.84.0",
    "@react-navigation/bottom-tabs": "^7.14.0",
    "@react-navigation/drawer": "^7.8.1",
    "@react-navigation/material-top-tabs": "^7.4.13",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.11.0",
    "axios": "^1.13.6",
    "base64-js": "^1.5.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "hermes-compiler": "250829098.0.9",
    "react": "19.2.3",
    "react-native": "^0.84.1",
    "react-native-animatable": "^1.4.0",
    "react-native-background-actions": "^4.1.0",
    "react-native-ble-plx": "^3.5.1",
    "react-native-blob-util": "^0.24.7",
    "react-native-chart-kit": "^6.12.0",
    "react-native-device-info": "^15.0.2",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-html-to-pdf": "^1.3.0",
    "react-native-keychain": "^10.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-notify-kit": "^10.2.1",
    "react-native-otplib": "^1.0.0",
    "react-native-pager-view": "^8.0.0",
    "react-native-pdf": "^7.0.3",
    "react-native-reanimated": "^4.2.2",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.23.0",
    "react-native-sensors": "^7.3.6",
    "react-native-share": "^12.2.5",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-svg": "^15.15.4",
    "react-native-uuid": "^2.0.3",
    "react-native-vector-icons": "^10.3.0",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "^0.11.0",
    "react-native-youtube-iframe": "^2.4.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-class-properties": "^7.28.6",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.28.6",
    "@babel/plugin-transform-optional-chaining": "^7.28.6",
    "@babel/plugin-transform-private-methods": "^7.28.6",
    "@babel/plugin-transform-private-property-in-object": "^7.28.6",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.1.3",
    "@react-native-community/cli-platform-android": "^20.1.3",
    "@react-native-community/cli-platform-ios": "^20.1.3",
    "@react-native/babel-preset": "0.84.0",
    "@react-native/eslint-config": "0.84.0",
    "@react-native/metro-config": "0.84.0",
    "@react-native/typescript-config": "0.84.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "ajv": "^8.18.0",
    "ajv-keywords": "^5.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
